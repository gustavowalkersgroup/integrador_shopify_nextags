# TLS automatico (Let's Encrypt). Exige APP_DOMAIN resolvendo pro IP da VPS
# e as portas 80 e 443 abertas — a validacao ACME passa pela 80.
{$APP_DOMAIN} {
	reverse_proxy app:3000

	# O handler de webhook da Shopify valida o HMAC do corpo cru; o Caddy nao
	# reescreve corpo, entao nada a fazer aqui alem de repassar.
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Sem X-Frame-Options: o app e embedded e roda DENTRO de um iframe do
		# admin da Shopify. Negar frame aqui deixaria a tela em branco pro
		# lojista. O controle certo e o CSP frame-ancestors que o
		# @shopify/shopify-app-react-router ja emite por loja.
		-Server
	}
}
