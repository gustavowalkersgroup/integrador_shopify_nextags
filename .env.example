# Copie para .env e preencha. .env NUNCA vai pro git (repo publico).

# Postgres (Neon). O de teste deve ser um branch/base separado:
# os testes fazem DELETE em massa nas tabelas.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_TEST=postgresql://user:pass@host/db_test?sslmode=require

# Shopify (Partner Dashboard > App > API credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://exemplo.vercel.app
SCOPES=read_orders,read_fulfillments,read_checkouts,read_products,read_inventory,read_customers
# app_store (app "nextagsai", App Store) ou single_merchant/vazio (app
# "Nextags_custom", Custom App) — cada deploy na Vercel usa um valor,
# conforme qual app Shopify aquele deploy serve. Ver docs/RUNBOOK.md.
SHOPIFY_APP_DISTRIBUTION=single_merchant

# Criptografia dos tokens de loja (AES-256-GCM, 32 bytes em base64)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Destino do evento canonico (adapter n8n)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# API NexTags
NEXTAGS_API_BASE=https://app.nextagsai.com.br
NEXTAGS_FLOWS_PATH=/api/accounts/flows

# Autenticacao dos endpoints de cron (quem agenda e o n8n, nao a Vercel)
CRON_SECRET=

# direct (default) ou n8n.
# direct: o app chama POST /api/contacts da NexTags com o token da propria
#   loja. Nao depende de infra extra — e o modo do app publico.
# n8n: envia o evento canonico para um workflow multi-tenant. Exige
#   N8N_WEBHOOK_URL acima; se faltar, o disparo falha com "nao configurada".
# NUNCA cadastre esta variavel vazia: vazio e tratado como ausente, mas um
# valor invalido (ex.: "webhook") faz o disparo falhar de proposito.
DISPATCH_MODE_DEFAULT=direct
