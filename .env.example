# Copie para .env e preencha. .env NUNCA vai pro git (repo publico).

# Postgres.
#
# NA VPS: deixe VAZIA para usar o Postgres do proprio compose. O compose so
# monta a URL a partir de POSTGRES_PASSWORD quando esta var esta vazia ou
# ausente (`${DATABASE_URL:-...}`) — um placeholder preenchido conta como
# valor real e o container tentaria conectar nele e morreria no boot.
#
# NA VERCEL / LOCAL: preencha com a URL do Neon.
#   formato: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
#
# So para `npm test`. Deve ser um branch/base separado: os testes fazem
# DELETE em massa nas tabelas.
DATABASE_URL_TEST=postgresql://user:pass@host/db_test?sslmode=require

# Deploy em VPS (docker-compose.yml). Ignorados na Vercel.
#
# APP_DOMAIN: dominio publico que o nginx da VPS atende. SHOPIFY_APP_URL vira
# https://$APP_DOMAIN. Nao inclua path aqui — o prefixo vai em APP_BASE_PATH.
APP_DOMAIN=integrador.nextags.com.br
#
# APP_BASE_PATH: prefixo de path sob o qual o app roda, quando ele divide o
# dominio com outra aplicacao. Vazio = app na raiz. Em integrador.nextags.com.br
# a raiz ja e servida por outra aplicacao, entao o app vive sob /notificacoes.
#
# NAO use "shopify" no valor: a Shopify recusa URLs de listagem que contenham
# essa palavra, inclusive no path (o campo Privacy policy URL rejeita).
#
# Muda o bundle do cliente, entao e build arg do Dockerfile — trocar o valor
# exige `docker compose up -d --build`, nao basta reiniciar o container.
APP_BASE_PATH=notificacoes
#
# Porta publicada em 127.0.0.1 para o nginx da VPS alcancar. So o loopback.
APP_PORT=3000
#
# Senha do Postgres do compose. So precisa se voce NAO usar DATABASE_URL
# externa (Neon); com DATABASE_URL preenchida acima, o servico postgres do
# compose fica sem uso.
POSTGRES_PASSWORD=

# Shopify (Partner Dashboard > App > API credentials).
#
# ATENCAO: sao DOIS apps Shopify distintos, e as credenciais NAO se misturam.
# Copiar o .env da Vercel para a VPS autentica o app errado.
#
#   VPS  -> app "NextagsIA" (App Store)
#           SHOPIFY_API_KEY = f552fc1ad87ec0f124f8d06a4f65ac81
#           SHOPIFY_APP_DISTRIBUTION = app_store
#   Vercel -> app "Nextags_custom" (Custom App)
#           SHOPIFY_API_KEY = f4f1311060ba64aafa712f94ab43552d
#           SHOPIFY_APP_DISTRIBUTION = single_merchant
#
# O SECRET de cada um sai do Partner Dashboard do app correspondente.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Na VPS o docker-compose deriva este valor de APP_DOMAIN; preencha aqui
# so para deploy na Vercel ou execucao local.
SHOPIFY_APP_URL=https://exemplo.vercel.app
SCOPES=read_orders,read_fulfillments,read_checkouts,read_products,read_inventory,read_customers
# app_store (app "NextagsIA", App Store — e o valor da VPS) ou
# single_merchant/vazio (app "Nextags_custom", Custom App, o da Vercel).
# Errar aqui muda o fluxo de instalacao que a lib da Shopify monta.
SHOPIFY_APP_DISTRIBUTION=single_merchant

# Criptografia dos tokens de loja (AES-256-GCM, 32 bytes em base64)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Destino do evento canonico (adapter n8n)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# API NexTags
NEXTAGS_API_BASE=https://app.nextagsai.com.br
NEXTAGS_FLOWS_PATH=/api/accounts/flows

# Autenticacao dos endpoints de cron (quem agenda e o n8n, nao a Vercel)
CRON_SECRET=

# n8n (default) ou direct.
# n8n: envia o evento canonico para o workflow multi-tenant compartilhado.
#   Exige N8N_WEBHOOK_URL acima; sem ela o disparo falha com "nao
#   configurada". Uma loja pode sobrescrever com o proprio webhook na tela.
# direct: o app chama POST /api/contacts da NexTags com o token da propria
#   loja, sem hop. Elimina o X-ACCESS-TOKEN viajando no payload app->n8n.
#
# NUNCA cadastre esta variavel VAZIA na Vercel. Vazio hoje e tratado como
# ausente (cai no default), mas ja custou caro: ate 2026-09-16 o app usava
# `process.env.DISPATCH_MODE_DEFAULT ?? "n8n"`, e como `??` so cobre
# null/undefined, a variavel vazia gravou dispatch_mode = "" em toda loja —
# nenhum disparo saiu por seis dias. Ou preencha, ou apague a variavel.
DISPATCH_MODE_DEFAULT=n8n
